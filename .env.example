# Supabase project URL and the public anon key.
# In newer Supabase projects this public key is labelled "publishable".
# Paste that value here. Never put the service-role or secret key in this file.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only Postgres connection. Used to cap early access at 500 people.
# Percent-encode special characters in the password. Do not commit the real value.
DATABASE_URL=

# Optional. Paste the Google Search Console HTML-tag token here when you verify the site.
# Do not invent a value. Leave this empty until Google gives you one.
GOOGLE_SITE_VERIFICATION=
